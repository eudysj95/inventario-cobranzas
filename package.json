{
  "name": "nexo",
  "version": "0.1.0",
  "private": true,
  "description": "Nexo - Inventory and collections management (apartados, credit sales, supplier debts).",
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "db:migrate": "npm run db:migrate --workspace server",
    "db:seed": "node server/scripts/seed-demo.js",
    "seed:prod": "npm run seed:prod --workspace server",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "test": "npm run test --workspace server",
    "build": "npm run build --workspace client",
    "design:build": "cd design-system && bun run build-tokens"
  },
  "dependencies": {
    "vite": "^6.0.7",
    "@vitejs/plugin-react": "^4.3.4"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED"
}
