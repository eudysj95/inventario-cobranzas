# Copy to .env and adjust. Never commit .env.
DATABASE_URL=postgresql://user:password@localhost:5432/inventario
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/inventario_test
PORT=3001

# Single shared admin, seeded when the admins table is empty.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
BCRYPT_ROUNDS=10

# JWT signing secret for the auth session cookie. REQUIRED in production
# (the server refuses to boot without it); a dev-only fallback is used when
# NODE_ENV is not 'production'.
JWT_SECRET=change-me-to-a-long-random-string

# Instance branding served by the PUBLIC GET /api/config endpoint (no auth).
# The SPA renders business name and currency from this endpoint instead of
# hardcoding them (Option B multi-instance: each deployment configures its
# own branding). Non-sensitive display values only — never put secrets here.
INSTANCE_BUSINESS_NAME=Mi Negocio
INSTANCE_CURRENCY_SYMBOL=$
INSTANCE_CURRENCY_LOCALE=es-AR
# Optional: shown as a display/contact link in the app shell. Leave empty to
# omit. NEVER used for customer collection wa.me links (those always use the
# customer's phone from the record).
INSTANCE_WHATSAPP_NUMBER=
