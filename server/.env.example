# Copy to .env and adjust. Never commit .env.
DATABASE_URL=postgresql://user:password@localhost:5432/inventario
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/inventario_test
PORT=3001

# Single shared admin, seeded when the admins table is empty.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
BCRYPT_ROUNDS=10

# JWT signing secret for the auth session cookie. REQUIRED in production
# (the server refuses to boot without it); a dev-only fallback is used when
# NODE_ENV is not 'production'.
JWT_SECRET=change-me-to-a-long-random-string
